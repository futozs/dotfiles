# Powerlevel10k instant prompt: keep at the top, nothing that prints output above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

DOTFILES="$HOME/Developer/personal/dotfiles"
BREW="${HOMEBREW_PREFIX:-/opt/homebrew}"

# ---------- oh-my-zsh ----------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
zstyle ':omz:update' mode reminder
DISABLE_MAGIC_FUNCTIONS=true   # pasting long commands stays instant
plugins=(git)
source "$ZSH/oh-my-zsh.sh"
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ---------- PATH ----------
export BUN_INSTALL="$HOME/.bun"
path=("$DOTFILES/bin" "$HOME/.local/bin" "$BUN_INSTALL/bin" $path)
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# ---------- History ----------
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY

# ---------- Tools ----------
eval "$(mise activate zsh)"
eval "$(direnv hook zsh)"
source <(fzf --zsh)                         # Ctrl+T files, Alt+C dirs
eval "$(atuin init zsh --disable-up-arrow)" # Ctrl+R; after fzf so it owns the binding
source "$HOME/Developer/personal/vscode-setup/shell/dev.zsh"   # p, pc, c, zoxide

export EDITOR="code --wait"
export BAT_THEME="Catppuccin Mocha"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# ---------- Aliases ----------
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -la --git --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --git-ignore --icons=auto'
alias cat='bat --paging=never'
alias lg='lazygit'
alias dev='cd ~/Developer'
alias reload='exec zsh'
alias ip='ipconfig getifaddr en0'
alias brewup='brew update && brew upgrade && brew cleanup'

mkcd() { mkdir -p "$1" && cd "$1"; }

# Machine-specific or secret settings that never go to GitHub.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ---------- Plugins (syntax highlighting must load last) ----------
source "$BREW/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$BREW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
