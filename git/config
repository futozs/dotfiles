# Shared git settings. ~/.gitconfig keeps [user] and machine-specific bits and includes this file.

[core]
	editor = code --wait
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true          # n / N jump between files
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"

[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true

[merge]
	conflictStyle = zdiff3

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	default = current
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[fetch]
	prune = true
	pruneTags = true

[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[commit]
	verbose = true

[help]
	autocorrect = prompt

[alias]
	s = status -sb
	lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %s %C(green)(%cr)%C(reset) %C(blue)%an%C(reset)%C(auto)%d' --abbrev-commit
	last = log -1 --stat
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	branches = branch -a --sort=-committerdate
	cleanup = !git branch --merged | grep -v -E '^\\*|main|master' | xargs -n 1 git branch -d
