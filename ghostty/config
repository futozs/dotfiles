# Ghostty — https://ghostty.org/docs/config
# Reload with Cmd+Shift+, after editing.

# ---------- Look ----------
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 14
adjust-cell-height = 10%
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-colorspace = display-p3
macos-titlebar-style = tabs
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
unfocused-split-opacity = 0.85

# ---------- Behaviour ----------
window-save-state = always
confirm-close-surface = false
copy-on-select = clipboard
clipboard-paste-protection = true
# Option stays Option: a Hungarian layout needs it for { } [ ] @ | \ ~
macos-option-as-alt = false
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ---------- Quick terminal ----------
# Alt+Space from anywhere drops a terminal from the top of the screen.
# Needs Accessibility permission for Ghostty (System Settings → Privacy & Security).
keybind = global:alt+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# ---------- Splits ----------
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
