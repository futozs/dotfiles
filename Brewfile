# brew bundle --file=Brewfile
# Everything this Mac runs, grouped by what it is for.

# --- Shell ---
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "atuin"            # searchable shell history (Ctrl+R)
brew "fzf"              # fuzzy finder (Ctrl+T files, Alt+C dirs)
brew "zoxide"           # z <part-of-dir>
brew "eza"              # ls with git status and icons
brew "bat"              # cat with syntax highlighting
brew "fd"
brew "ripgrep"
brew "jq"
brew "tldr"
brew "btop"
brew "fastfetch"
brew "direnv"           # per-project env vars from .envrc
brew "just"             # project task runner

# --- Git ---
brew "git"
brew "git-delta"        # side-by-side, syntax-highlighted diffs
brew "lazygit"
brew "gh"

# --- Languages and runtimes ---
brew "mise"             # per-project Node/Bun/Python versions (.nvmrc, .tool-versions, mise.toml)
brew "node"
brew "php"
brew "openjdk@17"
brew "openjdk@25"
brew "gradle"
brew "cmake"

# --- Data ---
brew "mysql"
brew "redis"

# --- Mobile ---
brew "xcodegen"
brew "scrcpy"
brew "apktool"
brew "libimobiledevice"
cask "android-commandlinetools"
cask "android-platform-tools"

# --- Network and servers ---
brew "httpd"
brew "nmap"
brew "iftop"
brew "ipcalc"
brew "speedtest-cli"
brew "sshpass"
brew "imapsync"
cask "mitmproxy"

# --- Media ---
brew "imagemagick"
brew "potrace"

# --- Apps ---
cask "ghostty"          # GPU-accelerated terminal
cask "helium-browser"   # Chromium without Google, uBlock Origin built in
cask "raycast"          # launcher, clipboard history, window management
cask "orbstack"         # Docker and Linux VMs, lighter than Docker Desktop/colima
cask "visual-studio-code"
cask "codexbar"
cask "another-redis-desktop-manager"

# --- Fonts ---
cask "font-jetbrains-mono-nerd-font"
cask "font-fira-code-nerd-font"
